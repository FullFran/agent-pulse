#!/usr/bin/env bash
# agent-heal — clears attention states you have already seen.
#
# The event pipeline has one structural hole: some transitions emit no event at
# all. Cancel an agent's permission prompt and no hook fires, so the pane stays
# "blocked" forever and the tab keeps shouting at you.
#
# The cheap fix is to treat *looking at the pane* as the missing event. If a
# window is on screen, its attention state has been delivered by definition, so
# it can be cleared. This is not a substitute for screen-tail detection — it
# recovers from missed clears, not from missed *sets* — but it costs one tmux
# call instead of a per-agent pattern matcher, and it never guesses wrong about
# something the user has not seen.
#
# It also covers the ordinary case, not just the pathological one: an agent that
# finished leaves its pane "idle", and without this the window stays marked
# forever — including long after the agent exited and the pane went back to
# being a plain shell.
#
# A window you never visit is the remaining gap, so finished panes also age out
# after @agent_pulse_idle_ttl seconds. No timer is needed for that: this walks
# every pane on every run, so any navigation anywhere sweeps the stale markers
# everywhere.
#
# Wired to navigation hooks (see tmux/agents.conf); safe to run on a timer too.
# Prints nothing.
set -uo pipefail
command -v tmux >/dev/null 2>&1 || exit 0

# shellcheck source=scripts/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

# Visibility here is deliberately WINDOW level, not pane level: every pane of the
# active window is on screen at once, so a blocked background pane has been seen
# too. Healing only the active pane would leave the tab marker stuck.
#
# The "-" placeholder keeps empty @agent_state fields from collapsing, because
# splitting on tabs merges consecutive separators.
# How long a finished pane stays marked when you never look at it. tmux options
# are the only configuration surface this project has, which is deliberate.
# Zero disables expiry entirely.
#
# Only "idle" ages out. "blocked" and "error" are requests that stay open until
# answered — an agent can legitimately wait an hour for you, and silently
# dropping that is worse than a stale marker.
ttl=$(tmux show-options -gqv @agent_pulse_idle_ttl 2>/dev/null)
case "$ttl" in ''|*[!0-9]*) ttl=1800 ;; esac

now_ns=$(date +%s%N 2>/dev/null)
case "$now_ns" in *N*|"") now_ns="$(date +%s)000000000" ;; esac

healed=0
touched_sessions=""
while IFS=$'\t' read -r pane st vis win ses seq; do
  if [ "$vis" != "1" ]; then
    # Off screen: nothing has been seen, so only age can justify clearing.
    [ "$ttl" -gt 0 ] || continue
    [ "$st" = "idle" ] || continue
    case "$seq" in ''|-|*[!0-9]*) continue ;; esac
    age=$(( (now_ns - seq) / 1000000000 ))
    [ "$age" -ge "$ttl" ] || continue

    tmux set-option -pu -t "$pane" @agent_state 2>/dev/null
    tmux set-option -pu -t "$pane" @agent_msg 2>/dev/null
    ap_recompute_rollup "$win"
    case " $touched_sessions " in
      *" $ses "*) ;;
      *) touched_sessions="$touched_sessions $ses" ;;
    esac
    healed=1
    continue
  fi
  case "$st" in
    # Every state that asks for attention, not just the loud ones. "Finished"
    # is a request to come and look, so once you have looked it is answered —
    # exactly like a permission prompt you have now seen.
    #
    # The state is unset rather than downgraded. Setting blocked to idle would
    # only trade a red marker for a yellow one, leaving the window lit after
    # you dealt with it. "working" is deliberately left alone: an agent that is
    # still going has not asked you for anything, and watching it work should
    # not make the marker disappear.
    idle|blocked|error)
      tmux set-option -pu -t "$pane" @agent_state 2>/dev/null
      tmux set-option -pu -t "$pane" @agent_msg 2>/dev/null
      ap_recompute_rollup "$win"
      case " $touched_sessions " in
        *" $ses "*) ;;
        *) touched_sessions="$touched_sessions $ses" ;;
      esac
      healed=1
      ;;
  esac
done < <(tmux list-panes -a -F \
  '#{pane_id}'$'\t''#{?#{@agent_state},#{@agent_state},-}'$'\t''#{&&:#{window_active},#{session_attached}}'$'\t''#{window_id}'$'\t''#{session_name}'$'\t''#{?#{@agent_seq},#{@agent_seq},-}' \
  2>/dev/null)

# Window rollups changed, so their sessions have to be recomputed too. Doing it
# once per session after the loop avoids recomputing the same session per pane.
for ses in $touched_sessions; do
  ap_recompute_session "$ses"
done

[ "$healed" = "1" ] && tmux refresh-client -S 2>/dev/null
exit 0
